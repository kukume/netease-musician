{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "netease-musician",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  // Dashboard 里配置的明文变量（如 CAP_URL / CAP_SITE_KEY）不要写进 vars。
  // wrangler.jsonc 里的空字符串每次部署都会覆盖 Dashboard。
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "netease-musician",
      "migrations_dir": "migrations"
    }
  ]
}
