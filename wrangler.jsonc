{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "netease-musician",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Cap Standalone：实例地址和 site key。私钥请放 .dev.vars 或 `wrangler secret put CAP_SECRET_KEY`。
  "vars": {
    "CAP_URL": "",
    "CAP_SITE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "netease-musician",
      "migrations_dir": "migrations"
    }
  ]
}
