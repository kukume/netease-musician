ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
SESSION_SECRET=please-change-this-to-a-long-random-string

# Cap Standalone（三项都填才会启用登录/注册验证码）
# 线上请在 Dashboard Variables 填写 CAP_URL / CAP_SITE_KEY，不要写进 wrangler.jsonc。
# CAP_URL=https://cap.example.com
# CAP_SITE_KEY=
# CAP_SECRET_KEY=

# 歌曲音频下载（netease-musician-audio）。未设置或空值默认关闭。
# 设为 1 / true / yes / on 才会向队列投递并下载播放地址。
# LISTEN_AUDIO_ENABLED=1

# Cloudflare Email Sending（绑定用户邮箱时发验证码）
# 任意外部邮箱需要 Workers Paid 并在 Dashboard 开通 Email Sending、接入发信域名。
# 免费档会拒绝未验证的收件人：可设置 RESEND_API_KEY，失败时改走 Resend。
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=云村互助
# RESEND_API_KEY=re_xxxxxxxxx
# Resend 发信地址。不填则用 onboarding@resend.dev（只能发给 Resend 账号自己的邮箱）。
# 要发给任意用户，在 Resend 验证域名后设置：
# RESEND_FROM=noreply@yourdomain.com
